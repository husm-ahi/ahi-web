---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import MembersSection from "../../components/sections/MembersSection.astro";

const members = (await getCollection("members")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="メンバー" description="浜松医科大学 先端医療情報学講座のメンバー紹介">
  <MembersSection members={members} showBio={true} />
</Base>
