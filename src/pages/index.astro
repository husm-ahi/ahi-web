---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import HeroMesh from "../components/HeroMesh.astro";
import NewsSection from "../components/sections/NewsSection.astro";
import MembersSection from "../components/sections/MembersSection.astro";
import PageSection from "../components/sections/PageSection.astro";
import { withBase } from "../utils/url";

const homepage = (await getCollection("homepage"))[0];

const news = (await getCollection("news", (n) => !n.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const members = (await getCollection("members")).sort(
  (a, b) => a.data.order - b.data.order
);

const homePages = await getCollection("pages", (p) => p.data.home);

type Section =
  | { kind: "news"; order: number }
  | { kind: "members"; order: number }
  | { kind: "page"; order: number; entry: (typeof homePages)[number] };

const sections: Section[] = [
  { kind: "news", order: 10 },
  { kind: "members", order: 50 },
  ...homePages.map((entry) => ({ kind: "page" as const, order: entry.data.homeOrder, entry })),
].sort((a, b) => a.order - b.order);
---

<Base>
  <div class="hero">
    <HeroMesh />
    <div class="hero-in">
      <h1 set:html={homepage.data.tagline ?? homepage.data.title} />
      <p class="sub">{homepage.data.title}</p>
    </div>
  </div>

  {sections.map((s) =>
    s.kind === "news" ? (
      <NewsSection items={news} moreHref={withBase("/news")} />
    ) : s.kind === "members" ? (
      <MembersSection members={members} showBio={false} moreHref={withBase("/members")} />
    ) : (
      <PageSection entry={s.entry} />
    )
  )}
</Base>
