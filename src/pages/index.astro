---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import HeroMesh from "../components/HeroMesh.astro";
import { withBase } from "../utils/url";

const homepage = (await getCollection("homepage"))[0];

const about = (await getCollection("pages", (p) => p.data.slug === "about"))[0];

const news = (await getCollection("news", (n) => !n.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
---

<Base>
  <div class="hero">
    <HeroMesh />
    <div class="hero-in">
      <h1 set:html={homepage.data.tagline ?? homepage.data.title} />
      <p class="sub">{homepage.data.title}</p>
    </div>
  </div>

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><h2>ニュース</h2></div>
      <ul class="news">
        {news.map((n) => (
          <li>
            <time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
            <a href={withBase(`/news/${n.data.slug}`)}>{n.data.title}</a>
          </li>
        ))}
      </ul>
      <a class="more" href={withBase("/news")}>すべてのニュース →</a>
    </div>
  </section>

  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head"><h2>講座について</h2></div>
      <p class="sub" style="max-width:44em">{about.data.description}</p>
      <a class="more" href={withBase(`/${about.data.slug}`)}>講座について詳しく見る →</a>
    </div>
  </section>
</Base>
