---
import Base from "../layouts/Base.astro";
import { withBase } from "../utils/url";
---

<Base title="ページが見つかりません">
  <section class="block">
    <div class="wrap" style="text-align:center;padding-top:60px;padding-bottom:60px">
      <p class="kicker">404</p>
      <h1 style="font-size:26px;font-weight:700;margin:16px 0 24px">ページが見つかりません</h1>
      <p style="color:var(--ink-soft)">URLが変更されたか、ページが削除された可能性があります。</p>
      <p style="margin-top:28px"><a class="more" href={withBase("/")}>トップページへ →</a></p>
    </div>
  </section>
</Base>
