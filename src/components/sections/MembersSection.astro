---
import { withBase } from "../../utils/url";
import type { CollectionEntry } from "astro:content";

interface Props {
  members: CollectionEntry<"members">[];
}

const { members } = Astro.props;
---

<section class="block" id="members">
  <div class="wrap">
    <div class="sec-head"><h2>メンバー</h2></div>
    <div class="members">
      {members.map((m) => (
        <div class="member">
          <div class="ph">
            {m.data.photo ? (
              <img src={withBase(m.data.photo)} alt={`${m.data.name}の顔写真`} />
            ) : (
              <span class="ph-fallback" aria-hidden="true">{m.data.name.charAt(0)}</span>
            )}
          </div>
          <div class="tx">
            <b>{m.data.name}</b>
            {m.data.role && <span class="role">{m.data.role}</span>}
            {m.data.researchmap && (
              <a class="rm" href={m.data.researchmap} target="_blank" rel="noopener">researchmap →</a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
