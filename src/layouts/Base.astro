---
import { getCollection } from "astro:content";
import { withBase } from "../utils/url";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const SITE_NAME = "浜松医科大学 先端医療情報学講座";
const { title, description } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const desc =
  description ??
  "浜松医科大学 先端医療情報学講座の公式サイト。医用画像・臨床データ・医療情報基盤を対象とした研究と教育を行っています。";

const navPages = await getCollection("pages", (p) => p.data.nav);

const navItems = [
  { label: "ニュース", order: 5, href: withBase("/#news") },
  { label: "メンバー", order: 50, href: withBase("/#members") },
  ...navPages.map((p) => ({
    label: p.data.title,
    order: p.data.order,
    href: withBase(p.data.home ? `/#${p.data.slug}` : `/${p.data.slug}`),
  })),
].sort((a, b) => a.order - b.order);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="nav">
        <a class="brand" href={withBase("/")}><span class="mark"></span>先端医療情報学講座</a>
        <nav aria-label="メイン">
          <ul>
            {navItems.map((item) => (
              <li><a class="nav-link" href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="f-in">
        <div>
          浜松医科大学 先端医療情報学講座<br />
          〒431-3192 静岡県浜松市中央区半田山1丁目20-1
        </div>
        <div>
          © Department of Advanced Healthcare Informatics,<br />
          Hamamatsu University School of Medicine
        </div>
      </div>
    </footer>
  </body>
</html>
